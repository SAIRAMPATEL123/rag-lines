# Environment Variables Template

# LLM Configuration
LLM_MODEL=mistral
LLM_BASE_URL=http://localhost:1235/v1
LLM_TEMPERATURE=0.3
LLM_TOP_K=40
LLM_TOP_P=0.9
LLM_MAX_TOKENS=1024

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# Chunking Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Retrieval Configuration
RETRIEVAL_TOP_K=20
RETRIEVAL_SCORE_THRESHOLD=0.1
USE_RERANKING=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2

# Vector Store Configuration
VECTORSTORE_PATH=./data/chroma_db
VECTORSTORE_TYPE=chroma

# Document Processing
DOCUMENT_STORAGE_PATH=./data/documents
MAX_FILE_SIZE=52428800  # 50MB in bytes

# Database Configuration
DB_TYPE=mysql  # mysql, sqlite, postgresql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=ETPL662
DB_NAME=rag_lines
DB_CONNECTION_STRING=mysql+pymysql://root:ETPL662@localhost:3306/rag_lines

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_RATE_LIMIT_PER_MINUTE=100
SCHEDULED_JOBS_DIR=./data/scheduled_jobs

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/rag-system.log

# Evaluation
EVALUATION_ENABLED=true
SAVE_EVAL_METRICS=true
METRICS_OUTPUT_PATH=./data/metrics
